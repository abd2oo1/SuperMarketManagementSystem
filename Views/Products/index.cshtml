@using WebApp.Models;
@model List<Product>
@section title{
    <h1>Products</h1>
}
    <div>
        <a class="btn btn-primary"   href="@($"/Products/Add")"  >Add Product</a>
    </div>
@if(Model != null && Model.Count()>0){

  <table class="table table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Category.Name</td>
                    <td>@product.Name</td>
                    <td>@product.Price?.ToString("c")</td>
                    <td>@product.Quantity</td>
                     <td>
                          <a class="btn btn-link" href="/Products/Edit/@product.ProductId"  >Edit</a> 
                          <a class="btn btn-link" href="/Products/Delete/@product.ProductId"   onclick="return ConfirmDelete(event)" >Delete</a>
                     </td>
                     
                </tr>
            }
        </tbody>
    </table>

@section Script{
    <script>
        function ConfirmDelete(event){

        return   confirm("Do you want to delete this Product? ");
        }
    </script>
}


  
}
       