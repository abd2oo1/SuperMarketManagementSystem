@using WebApp.Models;
@model List<Category>
@section title{
    <h1>Categories</h1>
}
  <div>
        <a class="btn btn-primary"   href="@($"/categories/AddCategory")"  >Add Category</a>
    </div>
@if(Model != null && Model.Count()>0){
  
  <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th></th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td><a class="btn btn-link" href="@($"/categories/EditCategory/{category.CategoryId}")">Edit</a></td>
                    <td>
                        @* <form method.preventDefault="Post" asp-controller="categories" asp-action="DeleteCategoryById" >
                            
                            <input  type="hidden" asp-for="@category.CategoryId"/>
                             <div class="row">
                                <div class="col-2">
                                    <input type="submit" class="btn btn-primary"  value="Delete" />
                                </div>
                            
                            </div>
                        </form> *@
                        <a class="btn btn-link" href="/categories/DeleteCategoryById/@category.CategoryId"   onclick="return ConfirmDelete(event,@category.CategoryId)" >Delete</a></td>
                </tr>
            }
        </tbody>
    </table>

@section Script{
