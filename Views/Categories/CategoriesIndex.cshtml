@using WebApp.Models;
@model List<Category>
@section title{
    <h1>Categories</h1>
}

@if(Model != null && Model.Count()>0){
    <div>
        <a class="btn btn-primary"   href="@($"/categories/AddCategory")"  >Add Category</a>
    </div>
  <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td><a class="btn btn-link" href="@($"/categories/EditCategory/{category.CategoryId}")">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
   @* <ul>


  @foreach(var category in Model)
  {
          <li >
                  <a href="/Categories/ShowCategory/@category.CategoryId">
                      @category.Name
                  </a>
          </li>
  }
        </ul> *@
}
       